{
  "name": "silavapi.co.uk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for silavapi.co.uk (Sīlavāpi / Ruth Cheesley) - accessible, privacy-first, built in the open.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "dev": "eleventy --serve --quiet",
    "build": "eleventy && npm run build:search",
    "build:search": "pagefind --site _site",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:html": "html-validate \"_site/**/*.html\"",
    "test:e2e": "playwright test",
    "test:a11y": "start-server-and-test \"node scripts/serve.mjs 8080\" http://localhost:8080 \"pa11y-ci\"",
    "test:links": "start-server-and-test \"node scripts/serve.mjs 8080\" http://localhost:8080 \"linkinator http://localhost:8080 --recurse --silent --skip 'linkedin.com|mastodon'\"",
    "test:lh": "lhci autorun",
    "test": "npm run test:coverage && npm run build && npm run test:html && npm run test:e2e && npm run test:a11y && npm run test:lh"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "browserslist": "^4.28.8",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "html-validate": "^11.6.2",
    "lightningcss": "^1.33.0",
    "linkinator": "^8.1.0",
    "lucide-static": "^1.33.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.1",
    "node-html-parser": "^9.0.1",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "turndown": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@svg-maps/world": "^2.0.0"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
