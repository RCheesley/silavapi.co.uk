{#- Site header. On wide screens the nav is a flat inline row; on narrow screens
    it collapses into a touch-friendly disclosure menu (native <details>, so it
    works without JavaScript and stays keyboard/AT accessible). -#}
<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/">
      <img src="/assets/img/logo-symbol.png" alt="" width="40" height="40" />
      <span class="site-header__name">Sīlavāpi</span>
    </a>
    <div class="site-nav">
      {#- Menu button: hidden without JS (CSS), where the full nav shows instead.
          With JS it toggles the panel below on narrow screens (nav.js). -#}
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="site-nav__toggle-icon site-nav__toggle-icon--open">{% icon "menu", 22 %}</span>
        <span class="site-nav__toggle-icon site-nav__toggle-icon--close">{% icon "x", 22 %}</span>
        <span class="site-nav__toggle-text">Menu</span>
      </button>
      <div class="site-nav__panel" id="site-menu">
        <nav aria-label="Main">
          <ul class="site-nav__list">
            {%- for item in nav.primary %}
              <li>
                <a
                  class="site-nav__link{{ ' is-active' if item.key == navActive }}"
                  href="{{ item.href }}"
                  {%- if item.key == navActive %} aria-current="page"{% endif %}
                  >{{ item.label }}</a
                >
              </li>
            {%- endfor %}
          </ul>
        </nav>
        {#- Colour-theme control. Hidden until theme.js reveals it (it does
            nothing without JS; the site still follows the OS scheme via CSS). -#}
        <div class="theme-toggle" role="group" aria-label="Colour theme" hidden>
          <button class="theme-toggle__btn" type="button" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light">{% icon "sun", 18 %}</button>
          <button class="theme-toggle__btn" type="button" data-theme-choice="system" aria-pressed="false" aria-label="Match system theme" title="System">{% icon "monitor", 18 %}</button>
          <button class="theme-toggle__btn" type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark">{% icon "moon", 18 %}</button>
        </div>
      </div>
    </div>
  </div>
</header>
