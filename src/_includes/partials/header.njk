{#- Site header — flat nav, no dropdowns. Skip link lives in base.njk.
    Phase 1 refines the visual treatment; the semantics here are final. -#}
<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/">
      <img src="/assets/img/logo-symbol.png" alt="" width="40" height="40" />
      <span class="site-header__name">Sīlavāpi</span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <ul class="site-nav__list">
        {%- for item in nav.primary %}
          <li>
            <a
              class="site-nav__link{{ ' is-active' if item.key == navActive }}"
              href="{{ item.href }}"
              {%- if item.key == navActive %} aria-current="page"{% endif %}
              >{{ item.label }}</a
            >
          </li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
