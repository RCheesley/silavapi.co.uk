<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {%- set fullTitle = (title + " · " + site.name) if (title and navActive != "home") else site.name -%}
    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}

    <!-- Open Graph - keep the former name discoverable during the transition. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ fullTitle }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:see_also" content="https://ruthcheesley.co.uk/" />

    <link rel="stylesheet" href="/assets/css/app.css" />
    {# Colour-theme control: loaded in <head> so a saved light/dark choice is
       applied before paint (no flash). Falls back to prefers-color-scheme. #}
    <script src="/assets/js/theme.js"></script>
    <link rel="icon" href="/assets/img/logo-symbol.png" type="image/png" />

    <!-- Person structured data with alternateName for findability. -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": {{ site.name | dump | safe }},
        "alternateName": {{ site.alternateName | dump | safe }},
        "url": {{ site.url | dump | safe }},
        "sameAs": ["https://ruthcheesley.co.uk/"]
      }
    </script>
    {# Reader text-size control: loaded in <head> on article pages so a saved
       size is applied before paint (no flash). #}
    {% if readerControl %}<script src="/assets/js/reader.js"></script>{% endif %}
    {# share.js loads everywhere: tweetables can appear on any page and it exits
       early when there are none. #}
    <script src="/assets/js/share.js" defer></script>
    <script src="/assets/js/nav.js" defer></script>
    {# Blog comments: reply handling + inline validation; exits early elsewhere. #}
    <script src="/assets/js/comments.js" defer></script>
    {% block head %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {% include "partials/header.njk" %}
    {#- Pagefind indexes only [data-pagefind-body] regions, so search covers the
        main content and skips chrome. noindex pages (thank-you, dev, 404) are
        left out. The section filter lets the blog scope search to itself. -#}
    {%- set pagefindSection = "page" -%}
    {%- if "/blog/" in page.url %}{% set pagefindSection = "blog" %}
    {%- elif "/speaking/" in page.url %}{% set pagefindSection = "speaking" %}{% endif -%}
    <main
      id="main"
      {%- if not noindex %} data-pagefind-body data-pagefind-filter="section:{{ pagefindSection }}"{% endif %}
    >
      {% block content %}{{ content | safe }}{% endblock %}
    </main>
    {% include "partials/footer.njk" %}
    {% include "partials/search-dialog.njk" %}
    <script src="/assets/js/search.js" defer></script>
  </body>
</html>
