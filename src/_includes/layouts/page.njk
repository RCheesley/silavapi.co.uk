---
layout: layouts/base.njk
---
{% from "macros/ui.njk" import sectionHeading %}
<article class="prose-page">
  <div class="stack">
    {{ sectionHeading("About me", title, 1, excerpt) }}
  </div>
  {% if image %}
    <p><img class="prose-page__lead" src="{{ image }}" alt="{{ imageAlt or '' }}" /></p>
  {% endif %}
  <div>{{ content | safe }}</div>
</article>
