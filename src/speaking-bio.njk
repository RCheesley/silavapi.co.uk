<section>
  <div class="prose-page">
    <div class="stack">
      {{ sectionHeading("Speaking", "Bio and photos", 1, "Help yourself - a bio you can copy and photos you’re welcome to use.") }}
      <p class="lead">
        I'm Sīlavāpi - you may have known me in the past as Ruth Cheesley. Below is a
        ready-to-use biography and a set of approved photos. Please use these rather than
        pulling images from elsewhere, and do get in touch if you need something in a
        different format or length.
      </p>
    </div>

    <section aria-labelledby="short-bio">
      <h2 id="short-bio">Short bio</h2>
      <blockquote class="bio-copy">
        <p>
          Sīlavāpi (formerly Ruth Cheesley) is a fractional operations and community leader
          with over 20 years of experience in open source. She helps mission-driven
          organisations build the operational foundations and communities they need to thrive,
          and is currently fractional Director of Operations at Mercury Consortium.
        </p>
        <p>
          She is also Project Lead for Mautic, supporting the community who build and maintain
          the world's first open source marketing automation platform. Earlier in her career
          she served on the Community Leadership Team of the Joomla! project and built a
          full-service digital agency, giving her a rare view of open source as a maintainer, a
          contributor and a business owner.
        </p>
        <p>
          Sīlavāpi is a lover of cats, a keen triathlete and flautist (but not at the same
          time!) and is based in the East of England.
        </p>
      </blockquote>
    </section>

    <section aria-labelledby="approved-photos">
      <h2 id="approved-photos">Approved photos</h2>
      <p>
        These are cleared for use in event listings and promotion. Please keep the credit
        shown with each set. Right-click to save, or use the download link under each one.
      </p>
      {% for group in photoGroups %}
        <div class="press-group">
          <div class="press-group__head">
            <h3 class="press-group__title">{{ group.heading }}</h3>
            {% if group.credit %}<p class="press-group__credit">Photos by {{ group.credit }}</p>{% endif %}
          </div>
          <ul class="press-photos">
            {% for p in group.photos %}
              <li class="press-photo">
                <img
                  src="/assets/img/photography/{{ p.file }}.jpg"
                  alt="{{ p.alt }}"
                  width="{{ p.w }}" height="{{ p.h }}"
                  loading="lazy" decoding="async" />
                <div class="press-photo__meta">
                  <span class="press-photo__label">{{ p.label }}</span>
                  <a class="press-photo__download"
                     href="/assets/img/photography/{{ p.file }}.jpg"
                     download="{{ p.download }}">Download {% icon "arrow-right", 14 %}</a>
                </div>
                {% if p.credit %}
                  <p class="press-photo__credit">Photo: {{ p.credit }}{% if p.licence %}, {% if p.licenceUrl %}<a href="{{ p.licenceUrl }}" rel="noopener noreferrer" target="_blank">{{ p.licence }}</a>{% else %}{{ p.licence }}{% endif %}{% endif %}</p>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </section>

    <div class="cluster">
      {{ button("Book me to speak", "/speaking/book/", "primary") }}
      {{ button("Speaker rider", "/speaking/rider/", "secondary") }}
      {{ button("Back to speaking", "/speaking/", "ghost") }}
    </div>
  </div>
</section>
