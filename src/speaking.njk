---
layout: layouts/base.njk
navActive: speaking
title: Speaking
permalink: /speaking/
description: >
  Sīlavāpi (Ruth Cheesley) speaks and runs workshops on open source, digital
  sovereignty, community, marketing automation with Mautic, and living actively
  with a disability. Invite me to speak, or browse past talks, slides and recordings.
speakingTopics:
  - Open source
  - Digital sovereignty
  - Community
  - Mautic
  - Accessibility
  - Living with EDS
speakingReadCategories:
  - Digital Sovereignty
  - Open source
  - Community
  - Mautic
  - Marketing
---
{% from "macros/ui.njk" import sectionHeading, button, badge, tag, articleCard %}
{%- set talks = collections.talks -%}
{%- set presentations = collections.talkPresentations -%}
{%- set upcoming = collections.upcomingPresentations -%}
{%- set past = collections.pastPresentations -%}
{%- set podcasts = collections.podcasts -%}
{%- set countries = presentations | presentationCountries -%}
{%- set firstYear = (presentations | last).date.getFullYear() if presentations | length else buildTime().getFullYear() -%}
{%- set speakingReads = collections.posts | byCategories(speakingReadCategories) | limit(3) -%}

<section>
  <div class="container speaking-hero">
    <div class="speaking-hero__portrait">
      <img src="/assets/img/photography/portrait-07.jpg" alt="Sīlavāpi speaking on stage" />
    </div>
    <div class="speaking-hero__col">
      {{ sectionHeading("Speaking", "Invite me to speak", 1, "I speak and run workshops on open source, digital sovereignty, community, marketing automation with Mautic, and living an active life with a disability - warmly, practically, and with a few strong opinions.") }}
      <div class="cluster">
        {% for t in speakingTopics %}{{ tag(t) }}{% endfor %}
      </div>
      <div class="cluster">
        {{ button("Book me to speak", "/speaking/book/", "primary") }}
        {{ button("Speaker rider", "/speaking/rider/", "secondary") }}
      </div>
    </div>
  </div>
</section>

{% if presentations | length %}
  {%- set keynoteCount = presentations | byFormat("Keynote") | length -%}
  <section class="band">
    <div class="container section-y-sm">
      <dl class="stat-row">
        <div><dd class="stat__num">{{ presentations | length }}</dd><dt class="stat__label">Talks given</dt></div>
        {% if keynoteCount %}<div><dd class="stat__num">{{ keynoteCount }}</dd><dt class="stat__label">Keynotes</dt></div>{% endif %}
        {% if podcasts | length %}<div><dd class="stat__num">{{ podcasts | length }}</dd><dt class="stat__label">Podcasts &amp; interviews</dt></div>{% endif %}
        <div><dd class="stat__num">{{ countries | length }}</dd><dt class="stat__label">Countries</dt></div>
        <div><dd class="stat__num">{{ firstYear }}</dd><dt class="stat__label">Speaking since</dt></div>
      </dl>
    </div>
  </section>

  {% if countries | length %}
    <section class="surface-subtle-band">
      <div class="container section-y-sm stack">
        {{ sectionHeading("Where I've spoken", "On stages around the world", 2) }}
        <div class="talks-map">
          {% talksMap countries %}
          <p class="talks-map__legend"><span class="talks-map__swatch"></span> Countries I've spoken in</p>
        </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{% if upcoming | length %}
  <section>
    <div class="container section-y stack">
      {{ sectionHeading("Coming up", "Upcoming talks", 2) }}
      <div class="card-grid">
        {% for p in upcoming %}
          <article class="talk-card">
            {% if p.cover %}
              <div class="talk-card__media">
                <img src="{{ p.cover }}" alt="" loading="lazy" />
                <span class="talk-card__badge">{{ badge("Upcoming", "accent") }}</span>
              </div>
            {% endif %}
            <div class="talk-card__body">
              <span class="talk-card__meta">{{ p.date | readableDate }}{% if p.event %} · {{ p.event }}{% endif %}{% if p.location.city %} · {{ p.location.city }}{% endif %}</span>
              <h3 class="talk-card__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
              {% if p.talk.data.excerpt %}<p class="article-card__excerpt">{{ p.talk.data.excerpt }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% if past | length %}
  <section class="surface-subtle-band">
    <div class="container section-y stack">
      {{ sectionHeading("The archive", "Past talks", 2) }}
      {% for group in past | groupByYear %}
        <div class="talk-year">
          <h3 class="talk-year__label">{{ group.year }}</h3>
          <ul class="talk-list">
            {% for p in group.items %}
              <li class="talk-list__item">
                <span class="talk-list__date">{{ p.date | readableDate }}</span>
                <span class="talk-list__title">
                  <a href="{{ p.url }}">{{ p.title }}</a>
                  {% if p.talk.data.format == "Keynote" %}<span class="badge badge--brand talk-list__flag">Keynote</span>{% endif %}
                  {% if p.event %}<span class="talk-list__event">{{ p.event }}{% if p.location.city %} · {{ p.location.city }}{% endif %}</span>{% endif %}
                </span>
                <span class="talk-card__actions">
                  {% if p.slides %}<a href="{{ p.slides }}">Slides (PDF)</a>{% endif %}
                  {% if p.video %}<a href="{{ p.video }}" rel="noopener noreferrer" target="_blank">Watch</a>{% endif %}
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if podcasts | length %}
  <section id="podcasts">
    <div class="container section-y stack">
      {{ sectionHeading("Off the stage", "Podcasts & interviews", 2, "Conversations, community calls and interviews - the more informal side of talking about this work.") }}
      <ul class="talk-list">
        {% for pod in podcasts %}
          <li class="talk-list__item">
            <span class="talk-list__date">{{ pod.date | readableDate }}</span>
            <span class="talk-list__title">
              <a href="{{ pod.url }}">{{ pod.data.title }}</a>
              {% if pod.data.events[0].event and pod.data.events[0].event != "Online" %}<span class="talk-list__event">{{ pod.data.events[0].event }}</span>{% endif %}
            </span>
            <span class="talk-card__actions">
              {% if pod.data.video %}<a href="{{ pod.data.video }}" rel="noopener noreferrer" target="_blank">Watch</a>{% endif %}
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% if speakingReads | length %}
  <section aria-label="Related writing">
    <div class="container section-y stack">
      <div class="recent-head">
        {{ sectionHeading("Go deeper", "On these topics, from the blog", 2) }}
        {{ button("All posts", "/blog/", "ghost") }}
      </div>
      <div class="card-grid">
        {% for post in speakingReads %}
          {{ articleCard({
            title: post.data.title,
            excerpt: post.data.excerpt,
            image: post.data.image,
            imageAlt: post.data.imageAlt,
            date: post.date | readableDate,
            category: post.data.category,
            tone: categories.tones[post.data.category] or "neutral",
            href: post.url
          }) }}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
